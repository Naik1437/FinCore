# FinCore Analytics Service Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=FinCore Analytics
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://fincore:YOUR_DB_PASSWORD@localhost:5432/fincore
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:4000"]

# API
API_V1_PREFIX=/api/v1

