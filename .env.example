# FinCore Environment Variables Template
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fincore
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Analytics Service (FastAPI)
ANALYTICS_URL=http://localhost:8000
ANALYTICS_HOST_PORT=8001

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8001

# Logging
LOG_LEVEL=info

# Security & Authentication (Assessment 04)
JWT_SECRET=fincore-dev-jwt-super-secret-key-32-characters-minimum
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=fincore-dev-refresh-token-secret-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Payments & Webhooks (Assessment 08)
WEBHOOK_SECRET=fincore_whsec_test_secret_for_simulation_123
PAYMENT_SIMULATOR_LATENCY_MS=0

# Sandbox Integrations (Assessment 08 — Optional Live Test Credentials)
# Stripe Test Mode (Leave blank to use built-in FinCore payment simulator)
STRIPE_SECRET_KEY=sk_test_mock_or_your_free_developer_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Twilio SMS Test Sandbox (Leave blank to use built-in FinCore SMS simulator)
# Magic test number: +15005550006
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_twilio_test_auth_token
TWILIO_FROM_PHONE=+15005550006

# Mailpit Email Sandbox (Zero credentials required, runs locally via Docker on 8025)
MAILPIT_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# Use a unique random value in deployed environments.
ANALYTICS_SERVICE_TOKEN=
BACKUP_ENCRYPTION_KEY=
